function ViewToolF()
    local Tools = {
        "NinjaKunai",
        "NinjaShuriken",
        "NinjaKatana",
        "ToolCleaver",
        "ToolDiggingForkRusty",
        "ToolPencil",
        "ToolPickaxe",
    }

    local Present = {
        "PresentSmall",
        "PresentBig",
        "BubbleBlower",
    }

    local WD = { "SprayCanWD" }
    local FEg = { "FireExtinguisher" }
    local Explosion = { "BombMissile", "BombDarkMatter" }

    local Nothing = {
        "FireworkSmokeBomb",
        "PoopPileSparkle",
        "PoopPile",
        "BombBalloon",
        "BucketPaint",
        "TeapotUtah",
    }

    local Blobman = { "CreatureBlobman" }
    local Cpf = { "Campfire" }
    local PourPart = { "ToiletWhite", "ToiletGold" }

    local function addView(item, partName, multiple, onlyView1, highTransparency)
        if not item:FindFirstChild("View1") then
            local sel = Instance.new("SelectionBox")
            sel.Name = "View1"
            sel.Adornee = item
            sel.LineThickness = 0.01
            sel.SurfaceTransparency = 1
            sel.Color3 = Color3.fromRGB(255, 255, 0)
            sel.Parent = item
        end

        if onlyView1 then return end

        local function createAdornment(part, index)
            if not item:FindFirstChild("View2_" .. index) then
                local adorn = Instance.new("BoxHandleAdornment")
                adorn.Name = "View2_" .. index
                adorn.Adornee = part
                adorn.Color3 = Color3.fromRGB(255, 255, 255)
                adorn.Transparency = highTransparency and 0.85 or 0.5
                adorn.ZIndex = 0
                adorn.AlwaysOnTop = true
                adorn.Size = part.Size
                adorn.Parent = item
            end
        end

        if multiple and partName then
            local count = 0
            for _, part in ipairs(item:GetDescendants()) do
                if part:IsA("BasePart") and part.Name == partName then
                    count += 1
                    createAdornment(part, count)
                end
            end
        elseif partName then
            local part = item:FindFirstChild(partName, true)
            if part and part:IsA("BasePart") then
                createAdornment(part, partName)
            end
        end
    end

    task.spawn(function()
        while ViewToolT and task.wait(0.1) do
            for _, folder in ipairs(workspace:GetChildren()) do
                if folder:IsA("Folder") and folder.Name:match("SpawnedInToys$") then
                    for _, item in ipairs(folder:GetChildren()) do
                        if item:IsA("Model") then
                            if table.find(Tools, item.Name) then
                                addView(item, "StickyPart")

                            elseif table.find(Present, item.Name) then
                                addView(item, "Hitbox")

                            elseif table.find(WD, item.Name) then
                                addView(item, "StickyRemoverPart", true, false, true)

                            elseif table.find(FEg, item.Name) then
                                addView(item, "ExtinguishPart", true, false, true)

                            elseif table.find(Explosion, item.Name) then
                                addView(item, "PartHitDetector", false, false, true)

                            elseif table.find(Cpf, item.Name) then
                                addView(item, "FirePlayerPart")

                            elseif table.find(PourPart, item.Name) then
                                addView(item, "PourPart", false, false, true)

                            elseif table.find(Blobman, item.Name) then
                                addView(item, "RightDetector", false, false, true)
                                addView(item, "LeftDetector", false, false, true)

                            elseif table.find(Nothing, item.Name) then
                                addView(item, nil, false, true)
                            end
                        end
                    end
                end
            end
        end

        for _, folder in ipairs(workspace:GetChildren()) do
            if folder:IsA("Folder") and folder.Name:match("SpawnedInToys$") then
                for _, item in ipairs(folder:GetChildren()) do
                    for _, v in ipairs(item:GetChildren()) do
                        if v.Name:match("^View1") or v.Name:match("^View2") then
                            v:Destroy()
                        end
                    end
                end
            end
        end
    end)
end

