    if not targetPart then return end

    local parent = targetPart.Parent
    local parentPath = GetObjectPath(parent)
    
    if anchoredParents[parentPath] then
        RemoveParentAnchor(parent)
    else
        AddParentAnchor(parent, targetPart)
    end
end)

function GetObjectPath(obj)
    local path = obj.Name
    local currentParent = obj.Parent
    
    while currentParent and currentParent ~= workspace do
        path = currentParent.Name .. "/" .. path
        currentParent = currentParent.Parent
    end
    
    return path
end

function AddParentAnchor(parent, targetPart)
    local fixedPos = targetPart.Position
    
    local bp = Instance.new("BodyPosition")
    bp.Name = "AnchorPosition"
    bp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    bp.P = 10000
    bp.D = 1000
    bp.Position = fixedPos
    bp.Parent = targetPart

    local bg = Instance.new("BodyGyro")
    bg.Name = "AnchorGyro"
    bg.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    bg.P = 100000
    bg.CFrame = targetPart.CFrame
    bg.Parent = targetPart

    if not parent:FindFirstChild("AnchorESP") then
        local box = Instance.new("SelectionBox")
        box.Name = "AnchorESP"
        box.Adornee = parent
        box.LineThickness = 0.015
        box.Color3 = Color3.fromRGB(0, 0, 255)
        box.Parent = parent
    end

    anchoredParents[GetObjectPath(parent)] = {
        Parent = parent,
        AnchoredPart = targetPart,
        FixedPos = fixedPos
    }
end

function RemoveParentAnchor(parent)
    local parentPath = GetObjectPath(parent)
    local anchoredData = anchoredParents[parentPath]
    
    if anchoredData and anchoredData.AnchoredPart then
        local part = anchoredData.AnchoredPart
        local bp = part:FindFirstChild("AnchorPosition")
        if bp then bp:Destroy() end
        
        local bg = part:FindFirstChild("AnchorGyro")
        if bg then bg:Destroy() end
    end

    local box = parent:FindFirstChild("AnchorESP")
    if box then box:Destroy() end

    anchoredParents[parentPath] = nil
end

function IsParentAnchored(parent)
    local parentPath = GetObjectPath(parent)
    return anchoredParents[parentPath] ~= nil
end

task.spawn(function()
    while true do
        task.wait(5)
        for parentPath, data in pairs(anchoredParents) do
            if not data.Parent or not data.Parent.Parent then
                anchoredParents[parentPath] = nil
            end
        end
    end
end)

task.spawn(function()
    while true do
        task.wait()
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        
        for parentPath, data in pairs(anchoredParents) do
            local parent = data.Parent
            local part = data.AnchoredPart
            if parent and parent.Parent and part and part.Parent then
                local oldPos = hrp.CFrame
                
                local isPlayer = parent:IsA("Model") and game.Players:GetPlayerFromCharacter(parent)
                
                if isPlayer then
                    local player = game.Players:GetPlayerFromCharacter(parent)
                    if player and player:FindFirstChild("IsHeld") and player.IsHeld.Value == false then
                        local ownerVal = part:FindFirstChild("PartOwner")
                        if not ownerVal or ownerVal.Value ~= plr.Name then
                            local distance = (hrp.Position - part.Position).Magnitude
                            if distance > 20 then
                                while part and part.Parent and player.IsHeld.Value == false do
                                    hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 5, 0))
                                    SetNetworkOwner:FireServer(part, hrp.CFrame)
                                    task.wait()
                                    ownerVal = part:FindFirstChild("PartOwner")
                                    if ownerVal and ownerVal.Value == plr.Name then
                                        break
                                    end
                                end
                            else
                                SetNetworkOwner:FireServer(part, hrp.CFrame)
                            end
                            hrp.CFrame = oldPos
                        end
                    end
                else
                    local ownerVal = part:FindFirstChild("PartOwner")
                    if not ownerVal or ownerVal.Value ~= plr.Name then
                        local distance = (hrp.Position - part.Position).Magnitude
                        if distance > 20 then
                            while part and part.Parent do
                                hrp.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
                                SetNetworkOwner:FireServer(part, hrp.CFrame)
                                task.wait()
                                ownerVal = part:FindFirstChild("PartOwner")
                                if ownerVal and ownerVal.Value == plr.Name then
                                    break
                                end
                            end
                        else
                            SetNetworkOwner:FireServer(part, hrp.CFrame)
                        end
                        hrp.CFrame = oldPos
                    end
                end
            else
                anchoredParents[parentPath] = nil
            end
        end
        
        for _, otherPlr in pairs(game.Players:GetPlayers()) do
            if otherPlr ~= plr and otherPlr.Character then
                local head = otherPlr.Character:FindFirstChild("Head")
                if head and otherPlr:FindFirstChild("IsHeld") and otherPlr.IsHeld.Value == false then
                    local ownerVal = head:FindFirstChild("PartOwner")
                    if ownerVal and ownerVal.Value ~= plr.Name then
                        local distance = (hrp.Position - head.Position).Magnitude
                        local oldPos = hrp.CFrame
                        if distance > 20 then
                            while head and head.Parent and otherPlr.IsHeld.Value == false do
                                hrp.CFrame = CFrame.new(head.Position + Vector3.new(0, 3, 0))
                                SetNetworkOwner:FireServer(head, hrp.CFrame)
                                task.wait()
                                ownerVal = head:FindFirstChild("PartOwner")
                                if ownerVal and ownerVal.Value == plr.Name then
                                    break
                                end
                            end
                        else
                            SetNetworkOwner:FireServer(head, hrp.CFrame)
                        end
                        hrp.CFrame = oldPos
                    end
                end
            end
        end
    end
end)

