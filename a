local autoWhitelistFriendsT = false
local alreadyWhitelisted = {}
local autoWhitelistThread = nil

local function waitForFriendAndWhitelist()
	while autoWhitelistFriendsT do
		local foundFriend = false

		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and player:IsFriendsWith(p.UserId) and not alreadyWhitelisted[p.Name] then
				table.insert(Whitelist, p.Name)
				alreadyWhitelisted[p.Name] = true
				if whitelistDropdown then
					whitelistDropdown:Refresh(Whitelist, true)
				end
				foundFriend = true
				break
			end
		end

		if not foundFriend then
			local friendJoined
			friendJoined = Players.PlayerAdded:Connect(function(p)
				if autoWhitelistFriendsT and player:IsFriendsWith(p.UserId) and not alreadyWhitelisted[p.Name] then
					table.insert(Whitelist, p.Name)
					alreadyWhitelisted[p.Name] = true
					if whitelistDropdown then
						whitelistDropdown:Refresh(Whitelist, true)
					end
				end
			end)

			repeat task.wait(1) until not autoWhitelistFriendsT or #Players:GetPlayers() >= 2

			if friendJoined then
				friendJoined:Disconnect()
			end
		end

		task.wait(0.001)
	end
end

