function AutoShurikenF()
    task.spawn(function()
        local rs = game:GetService("ReplicatedStorage")
        local plr = game.Players.LocalPlayer
        local invName = plr.Name .. "SpawnedInToys"

        local SpawnToyRemoteFunction = rs.MenuToys.SpawnToyRemoteFunction
        local StickyPartEvent = rs.PlayerEvents.StickyPartEvent
        local DestroyToy = rs.MenuToys.DestroyToy

        local currentSession = 0
        local connCharAdded = nil
        local debug = false

        local function findRagdoll(char, hrp)
            local LL = char:FindFirstChild("Left Leg")
            if LL then
                local r = LL:FindFirstChild("RagdollLimbPart")
                if r then return r end
            end
            if hrp then
                local r = hrp:FindFirstChild("RagdollTouchedHitbox")
                if r then return r end
            end
            return nil
        end

        local function setupCharacter(char)
            currentSession = currentSession + 1
            local mySession = currentSession
            if debug then warn("AutoShuriken: setupCharacter session", mySession) end

            local hum = char:FindFirstChild("Humanoid") or char:WaitForChild("Humanoid", 5)
            local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
            if not hum or not hrp then
                if debug then warn("AutoShuriken: missing humanoid/hrp, abort") end
                return
            end

            local connHumDied
            connHumDied = hum.Died:Connect(function()
                currentSession = currentSession + 1
                if debug then warn("AutoShuriken: humanoid died, invalidate session", mySession) end
                if connHumDied then connHumDied:Disconnect() connHumDied = nil end
            end)

            local lastSpawnTick = 0

            task.spawn(function()
                while autoShurikenT and currentSession == mySession do
                    if not char.Parent or not hum or hum.Health <= 0 then
                        if debug then warn("AutoShuriken: char gone or dead, breaking", mySession) end
                        break
                    end

                    local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
                    local head = char:FindFirstChild("Head")
                    local ragdollHitbox = findRagdoll(char, hrp)

                    local inv = workspace:FindFirstChild(invName)

                    local hasAttached = false
                    local closestShuriken = nil
                    local closestDist = math.huge

                    if inv then
                        for _, shuriken in ipairs(inv:GetChildren()) do
                            if shuriken and shuriken.Name == "NinjaKunai" then
                                local sticky = shuriken:FindFirstChild("StickyPart")
                                if sticky then
                                    local weld = sticky:FindFirstChild("StickyWeld")
                                    if weld and ragdollHitbox and weld.Part1 == ragdollHitbox then
                                        hasAttached = true
                                        break
                                    else
                                        if torso and sticky.Position then
                                            local dist = (torso.Position - sticky.Position).Magnitude
                                            
                                            if dist > 20 then
                                                pcall(function()
                                                    if debug then warn("AutoShuriken: destroying far shuriken", shuriken) end
                                                    DestroyToy:FireServer(shuriken)
                                                end)
                                            elseif dist < closestDist then
                                                closestDist = dist
                                                closestShuriken = shuriken
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end

                    if hasAttached then
                    elseif closestShuriken and ragdollHitbox and hum.Health > 0 then
                        local sticky = closestShuriken:FindFirstChild("StickyPart")
                        if sticky and sticky.Parent then
                            if debug then warn("AutoShuriken: firing StickyPartEvent", sticky, ragdollHitbox) end
                            pcall(function()
                                SetNetworkOwner:FireServer(sticky, sticky.CFrame)
                                StickyPartEvent:FireServer(sticky, ragdollHitbox, CFrame.new() * CFrame.Angles(math.rad(90), 0, math.rad(180)))
                            end)
                        end
                    elseif head and (tick() - lastSpawnTick) > 0.45 then
                        lastSpawnTick = tick()
                        task.spawn(function()
                            local offset = head.CFrame.LookVector * -20
                            local spawnCF = head.CFrame + Vector3.new(0, 5, 0) + offset
                            if debug then warn("AutoShuriken: invoking spawn", spawnCF) end
                            pcall(function()
                                SpawnToyRemoteFunction:InvokeServer("NinjaKunai", spawnCF, spawnCF.Position)
                            end)
                        end)
                    end

                    task.wait(0.1)
                end

                if connHumDied then connHumDied:Disconnect() connHumDied = nil end
                if debug then warn("AutoShuriken: session ended", mySession) end
            end)
        end

        if plr.Character then
            setupCharacter(plr.Character)
        end

        if connCharAdded then connCharAdded:Disconnect() connCharAdded = nil end
        connCharAdded = plr.CharacterAdded:Connect(function(char)
            currentSession = currentSession + 1
            setupCharacter(char)
        end)

        while autoShurikenT and task.wait(1) do end
        if connCharAdded then connCharAdded:Disconnect() connCharAdded = nil end
        currentSession = currentSession + 1
        if debug then warn("AutoShuriken: top-level exiting") end
    end)
end

